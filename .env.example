# CIOS — Content Intelligence Operating System for YouTube (zero-cost edition)
# 1) OpenRouter pe free account banao: https://openrouter.ai/keys (email ya GitHub, card nahi chahiye)
# 2) API key banao aur neeche paste karo. Sirf :free models use honge — koi kharcha nahi.
OPENROUTER_API_KEY=

# Auth (default ON). Local dev me single-user mode ke liye AUTH_REQUIRED=false.
AUTH_REQUIRED=true
# Lambi random secret — production me LAZMI set karo (dashboard secret on Render).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional overrides:
# APP_HOST=127.0.0.1
# APP_PORT=8000
# DAILY_REQUEST_CAP=48
# APP_PUBLIC_URL=https://tumhara-domain.com  (OpenRouter HTTP-Referer header)
